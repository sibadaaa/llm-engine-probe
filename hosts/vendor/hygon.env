# 用途：本站现网厂商：固定 VENDOR=hygon，并按正确顺序注入本机真实存在的 DTK 环境。
# 适用：装了 DTK 的海光 DCU 裸机（本站 z100，4 卡），hy-smi 可用、/dev/kfd 与 /dev/mkfd 存在。
# 组合：hosts/vllm-host.sh up vendor/hygon scenario/tp4-prod spec/dflash
# ============================================================================
# 厂商模板：海光 DCU（DTK / ROCm 系，物理机裸跑，RUNTIME=host）
# ============================================================================
# 说明：模板固定厂商身份，并只在「本机确实存在」时注入 DTK 环境（先 export DTK_ROOT，
#       再 source 依赖它的 DCU env.sh）；不改模型/并行/卡号。HOST_PYTHON 指向的 venv
#       里必须已装 DCU 版 torch + vllm。
#
# 覆盖键：VENDOR（.env 里的 VENDOR=auto 会被改成 hygon）；
#         HOST_PRELUDE_FILES（仅当 .env/命令行都没设置、且本机存在 DCU env.sh 时注入）；
#         HSA_FORCE_FINE_GRAIN_PCIE（用 :- 兜底为 1，不会覆盖你已显式设置的值）。
# 风险：* 不 source DTK 时 `import torch` 会报 librocm_smi64.so.2: cannot open shared
#         object file —— 这正是 HOST_PRELUDE_FILES 的作用，别删；
#       * 本模板不设 VISIBLE_DEVICES：卡号沿用 .env（默认 0,1,2,3）。实际卡数不足时必须
#         显式 VISIBLE_DEVICES=...，否则 vLLM 初始化报设备数不足；
#       * 可见性变量是 HIP_VISIBLE_DEVICES（vendors/hygon.sh 的 VENDOR_DEVICE_VIS_ENV 按
#         VISIBLE_DEVICES 生成），模板不直接写它；
#       * .env 里的 DTK_ENV_FILE / DCU_ENV_FILE 只对 docker 模式生效，host 模式完全不读，
#         不要以为改了它们就能生效——host 模式请改 HOST_PRELUDE_FILES；
#       * HSA_FORCE_FINE_GRAIN_PCIE 影响 RCCL P2P；多卡 TP 时若显式改成 0 可能挂死或变慢。
# ============================================================================

# --- 厂商身份 ---
VENDOR=hygon

# --- 启动前环境（HOST_PRELUDE_FILES）---
# 格式：空格分隔的 token，按顺序执行；`K=V` 先 export，其它 token 视为路径、存在才 source。
# 顺序有意义：DCU 的 env.sh 依赖先 export 的 DTK_ROOT（见 .env.example 同名示例）。
# 只在两件事同时成立时注入：① 用户没显式设置（.env 为空且命令行未导出）；
#                          ② 本机确实存在该 env.sh。DTK_ROOT 目录不存在时退化为只 source。
if [[ -z "${HOST_PRELUDE_FILES:-}" && -f /home/lyh/z100-vllm/tools/dcu/env.sh ]]; then
  if [[ -d /mnt/game/host-runtime/dtk2604 ]]; then
    HOST_PRELUDE_FILES="DTK_ROOT=/mnt/game/host-runtime/dtk2604 /home/lyh/z100-vllm/tools/dcu/env.sh"
  else
    HOST_PRELUDE_FILES="/home/lyh/z100-vllm/tools/dcu/env.sh"
  fi
fi

# --- 厂商相关环境变量（用 :- 兜底，显式设置优先）---
# 现网走 RCCL P2P 需要它；.env 一般已有 HSA_FORCE_FINE_GRAIN_PCIE=1。
HSA_FORCE_FINE_GRAIN_PCIE="${HSA_FORCE_FINE_GRAIN_PCIE:-1}"
