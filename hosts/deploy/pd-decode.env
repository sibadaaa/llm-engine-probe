# 用途：PD 分离中 decode 实例的配置骨架，作为 KV consumer 角色。
# 适用：vLLM 版本支持 --kv-transfer-config、且已确认 KV connector 可用的机器；默认按 4 卡 TP=4 写。
# 组合：推荐由 hosts/deploy/pd-run.sh 叠加（它负责 KV_CONNECTOR 与端口）；单独复核用 hosts/vllm-host.sh show deploy/pd-decode。
#
# 覆盖键：MODEL SERVED_NAME TP PORT GPU_MEM_UTIL MAX_MODEL_LEN MAX_NUM_BATCHED_TOKENS
#         MAX_NUM_SEQS EAGER VISIBLE_DEVICES PROBE_LEVEL WARMUP_TIMEOUT EXTRA_VLLM_ARGS
#         DRAFT_MODEL SPEC_METHOD SPEC_TOKENS SPEC_DTYPE SPEC_KV_DTYPE SPEC_EXTRA_JSON（置空）
# 风险：
#   * 实验性骨架，默认拒绝启动：pd-run.sh 只有 PD_ENABLE=1 且 KV_CONNECTOR 非空才继续。
#   * 本文件不写 KV_CONNECTOR / --kv-transfer-config：connector 与 kv_role=kv_consumer
#     由 pd-run.sh 生成；connector 需要的额外字段请用 EXTRA_ENV/EXTRA_VLLM_ARGS 显式给。
#   * 同机同时跑 prefill+decode 会抢显存：默认 VISIBLE_DEVICES=0,1,2,3，
#     同机调试请把本文件改成 4,5,6,7（或分成两台机器，各用 0-3）。
#   * PORT=8201 只用于单模板 show/dry-run；pd-run.sh 会用 DECODE_PORT 显式覆盖。
#   * 清空投机解码：PD 骨架不叠 spec/*.env，避免继承 .env 的 DFlash 草稿配置。
#   * PD 还需要前置代理/路由与压测客户端（见 hosts/deploy/pd-README.md），
#     两个实例各自只提供半套能力，不能把客户端直接指向某一个实例。

MODEL=/mnt/game/models/Qwen3.8-27B-FP8
SERVED_NAME=qwen3.8-27b
TP=4
PORT=8201
GPU_MEM_UTIL=0.85
MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=64
EAGER=1
VISIBLE_DEVICES=0,1,2,3
PROBE_LEVEL=steps
# PD 冷启动（两实例 + KV 握手）比单实例慢，给 start_vllm.sh 更宽的 /health 等待
WARMUP_TIMEOUT=1800
# 保留上游（.env / 场景模板）已有参数，本骨架不重置；--kv-transfer-config 由 pd-run.sh 生成
EXTRA_VLLM_ARGS="${EXTRA_VLLM_ARGS:-}"

# 清空投机解码：只用目标模型，避免 .env 的 DRAFT_MODEL/SPEC_* 漏进来
DRAFT_MODEL=
SPEC_METHOD=
SPEC_TOKENS=
SPEC_DTYPE=
SPEC_KV_DTYPE=
SPEC_EXTRA_JSON=
