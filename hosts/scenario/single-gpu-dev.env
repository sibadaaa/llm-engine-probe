# 用途：单卡冒烟/调试基线 —— 最小显存、4K 上下文、eager，先确认 vLLM 能起来再上生产场景。
# 适用：单卡机型（0 号卡）；要求本机存在 /mnt/game/models/Qwen3-0.6B（换机器用 MODEL=... 覆盖）。
# 组合：hosts/vllm-host.sh show|dry-run scenario/single-gpu-dev；也可叠在 vendor/<厂商>.env 之后（厂商 → 场景）。
#
# 覆盖键：MODEL SERVED_NAME TP VISIBLE_DEVICES DTYPE GPU_MEM_UTIL
#         MAX_MODEL_LEN MAX_NUM_BATCHED_TOKENS MAX_NUM_SEQS EAGER PORT
#         DRAFT_MODEL SPEC_METHOD SPEC_TOKENS SPEC_DTYPE SPEC_KV_DTYPE SPEC_EXTRA_JSON
#         EXTRA_VLLM_ARGS EXTRA_ENV（投机解码 6 个键、EXTRA_VLLM_ARGS、EXTRA_ENV 一律置空）
# 风险：
#   * 置空 EXTRA_VLLM_ARGS / EXTRA_ENV 是刻意的：单卡调试不继承 .env 里的现网厂商参数
#     （--disable-custom-all-reduce、VLLM_DCU_* 等）。要复现生产行为请再叠 vendor/quant 模板。
#   * GPU_MEM_UTIL=0.5：同卡已有其它实例时仍可能 OOM；PORT=8101 便于与现网 8100 并存。
#   * 置空 SPEC_TOKENS 后，若再叠加只给 DRAFT_MODEL/SPEC_METHOD 的投机模板，需自行补 SPEC_TOKENS
#     （否则 --speculative-config 里的 num_speculative_tokens 为空）。
#   * 0.6B 只用于冒烟，吞吐/显存结论不能外推到 27B 生产臂。

MODEL=/mnt/game/models/Qwen3-0.6B
SERVED_NAME=qwen3-0.6b
TP=1
VISIBLE_DEVICES=0
DTYPE=float16
GPU_MEM_UTIL=0.5
MAX_MODEL_LEN=4096
MAX_NUM_BATCHED_TOKENS=2048
MAX_NUM_SEQS=8
EAGER=1
PORT=8101

# 重置投机解码：单卡调试不继承 .env 的 dflash 生产配置（需要时在后面叠 spec/*.env）
DRAFT_MODEL=
SPEC_METHOD=
SPEC_TOKENS=
SPEC_DTYPE=
SPEC_KV_DTYPE=
SPEC_EXTRA_JSON=

# 重置厂商/现网额外参数：调试实例的失败原因应来自 vLLM 本身，而不是继承来的透传参数
EXTRA_VLLM_ARGS=
EXTRA_ENV=
