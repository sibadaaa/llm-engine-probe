# 用途：长上下文场景（27B FP8 / TP=4 / MAX_MODEL_LEN=131072，即 128K）。
# 适用：4 卡同机（可见卡 0-3）+ 足够显存；/mnt/game/models/Qwen3.8-27B-FP8 存在，vLLM 支持 128K 配置。
# 组合：vendor/hygon → scenario/long-context-128k，例如
#       RUNS_DIR=/tmp/x hosts/vllm-host.sh dry-run scenario/long-context-128k
#
# 覆盖键：MODEL SERVED_NAME TP VISIBLE_DEVICES DTYPE GPU_MEM_UTIL MAX_MODEL_LEN
#         MAX_NUM_BATCHED_TOKENS MAX_NUM_SEQS EAGER PORT EXTRA_VLLM_ARGS
#         DRAFT_MODEL SPEC_METHOD SPEC_TOKENS SPEC_DTYPE SPEC_KV_DTYPE SPEC_EXTRA_JSON（置空）
# 风险：
#   * KV cache 显存风险最高的一档：131072 上下文 × 27B，单条长请求就可能吃掉大半 KV 池；
#     GPU_MEM_UTIL=0.92 已接近上限，同卡跑其它进程会直接失败。
#   * 首次启动前先 dry-run 确认 --max-model-len 131072 被 vLLM 接受（--max-model-len 超过
#     模型配置上限会启动报错）；真实启动会做长耗时 warmup/编译，建议 WARMUP_TIMEOUT 调大。
#   * MAX_NUM_BATCHED_TOKENS=8192 故意小于 max-model-len：32K/128K 的 prefill 会被分块，
#     TTFT 上升但避免一次性 OOM；要更快的 TTFT 可显式覆盖这个键。
#   * EXTRA_VLLM_ARGS 用现网 DCU 值；--mamba-cache-mode 需要对应 vLLM 版本。
#   * 不设置 EXTRA_ENV（厂商相关），保留本机 .env 的取值。

MODEL=/mnt/game/models/Qwen3.8-27B-FP8
SERVED_NAME=qwen3.8-27b
TP=4
VISIBLE_DEVICES=0,1,2,3
DTYPE=float16
GPU_MEM_UTIL=0.92
MAX_MODEL_LEN=131072
MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=32
EAGER=1
PORT=8103
# 注：--mamba-cache-mode 在较新 vLLM 已 deprecated/no-op（现网 0.18.1 仍接受）；升级后按版本移除
EXTRA_VLLM_ARGS="--disable-custom-all-reduce --skip-mm-profiling --enable-prefix-caching --mamba-cache-mode align"

# 清空投机解码：128K 场景下草稿模型额外占显存，投机解码收益也不稳定（需要时再叠 spec/*.env）
DRAFT_MODEL=
SPEC_METHOD=
SPEC_TOKENS=
SPEC_DTYPE=
SPEC_KV_DTYPE=
SPEC_EXTRA_JSON=
