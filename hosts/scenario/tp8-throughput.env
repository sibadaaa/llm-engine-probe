# 用途：8 卡高吞吐场景（27B FP8 / TP=8 / batched-tokens 32K / MAX_NUM_SEQS=256 / 关闭 eager）。
# 适用：单机 8 卡（可见卡 0-7）且 /mnt/game/models/Qwen3.8-27B-FP8 存在；少于 8 卡会直接启动失败。
# 组合：vendor/hygon → scenario/tp8-throughput →（可选）spec/dflash，例如
#       hosts/vllm-host.sh dry-run vendor/hygon scenario/tp8-throughput
#
# 覆盖键：MODEL SERVED_NAME TP VISIBLE_DEVICES DTYPE GPU_MEM_UTIL MAX_MODEL_LEN
#         MAX_NUM_BATCHED_TOKENS MAX_NUM_SEQS EAGER PORT EXTRA_VLLM_ARGS
#         DRAFT_MODEL SPEC_METHOD SPEC_TOKENS SPEC_DTYPE SPEC_KV_DTYPE SPEC_EXTRA_JSON（置空）
# 风险：
#   * 必须 8 张可见卡；TP=8 在 8 卡机器上跨 NUMA/互联，P2P 不通时会退化甚至报错。
#   * EAGER=0 表示默认走图模式（没有 --enforce-eager）。注意用 kernel 档启动时
#     （up-kernel / 逐层 NVTX）start_vllm.sh 会自动追加 --enforce-eager，图模式被关闭，
#     届时吞吐数字不能与本档位对比。
#   * GPU_MEM_UTIL=0.9 + batched-tokens 32768：显存告急时会先驱逐 KV，长请求仍可能 OOM。
#   * EXTRA_VLLM_ARGS 用现网 DCU 值；换厂商/版本先 dry-run 复核 --mamba-cache-mode 是否支持。
#   * 不设置 EXTRA_ENV（厂商相关），保留本机 .env 的取值。

MODEL=/mnt/game/models/Qwen3.8-27B-FP8
SERVED_NAME=qwen3.8-27b
TP=8
VISIBLE_DEVICES=0,1,2,3,4,5,6,7
DTYPE=float16
GPU_MEM_UTIL=0.9
MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS=32768
MAX_NUM_SEQS=256
EAGER=0
PORT=8102
# 注：--mamba-cache-mode 在较新 vLLM 已 deprecated/no-op（现网 0.18.1 仍接受）；升级后按版本移除
EXTRA_VLLM_ARGS="--disable-custom-all-reduce --skip-mm-profiling --enable-prefix-caching --mamba-cache-mode align"

# 清空投机解码：高吞吐基线与投机解码分开测，避免把两者收益混在一起（需要时再叠 spec/*.env）
DRAFT_MODEL=
SPEC_METHOD=
SPEC_TOKENS=
SPEC_DTYPE=
SPEC_KV_DTYPE=
SPEC_EXTRA_JSON=
