# 用途：对齐现网生产臂（27B FP8 / TP=4 / 32K 上下文 / eager），作为 A/B 与压测的基准场景。
# 适用：4 卡同机（可见卡 0-3）且 /mnt/game/models/Qwen3.8-27B-FP8 存在；vLLM 需支持 --mamba-cache-mode。
# 组合：vendor/hygon → scenario/tp4-prod → spec/dflash，例如
#       hosts/vllm-host.sh up vendor/hygon scenario/tp4-prod spec/dflash
#       （单独用 scenario/tp4-prod 时无投机解码，吞吐低于现网）
#
# 覆盖键：MODEL SERVED_NAME TP VISIBLE_DEVICES DTYPE GPU_MEM_UTIL MAX_MODEL_LEN
#         MAX_NUM_BATCHED_TOKENS MAX_NUM_SEQS EAGER PORT EXTRA_VLLM_ARGS
#         DRAFT_MODEL SPEC_METHOD SPEC_TOKENS SPEC_DTYPE SPEC_KV_DTYPE SPEC_EXTRA_JSON（置空）
# 风险：
#   * 本模板清空投机解码，投机解码由其后叠加的 spec/*.env 决定；不叠 spec 时
#     deep/kernel 档的逐请求投机解码指标不可用（无数据）。
#   * EXTRA_VLLM_ARGS 是现网 DCU 经验值：--disable-custom-all-reduce 在海光之外通常是空操作，
#     --mamba-cache-mode align 需要相应 vLLM 版本；换厂商/换版本前先 dry-run 复核。
#   * 不设置 EXTRA_ENV（厂商相关），保留本机 .env 的取值。
#   * PORT=8100 与现网实例同端口：同一台机器上不能同时起两个 8100 实例。

MODEL=/mnt/game/models/Qwen3.8-27B-FP8
SERVED_NAME=qwen3.8-27b
TP=4
VISIBLE_DEVICES=0,1,2,3
DTYPE=float16
GPU_MEM_UTIL=0.85
MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=64
EAGER=1
PORT=8100
# 注：--mamba-cache-mode 在较新 vLLM 已 deprecated/no-op（现网 0.18.1 仍接受）；升级后按版本移除
EXTRA_VLLM_ARGS="--disable-custom-all-reduce --skip-mm-profiling --enable-prefix-caching --mamba-cache-mode align"

# 清空投机解码：由 spec/*.env 叠加决定（避免只写一半草稿配置导致 --speculative-config 非法）
DRAFT_MODEL=
SPEC_METHOD=
SPEC_TOKENS=
SPEC_DTYPE=
SPEC_KV_DTYPE=
SPEC_EXTRA_JSON=
