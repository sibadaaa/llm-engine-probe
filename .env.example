# ============================================================================
# llm-engine-probe 配置模板（多厂商）
#
# 使用：cp .env.example .env && 按需修改
# 所有变量都可以用环境变量临时覆盖，例如：
#   PROBE_LEVEL=kernel scripts/start_vllm.sh
#   VENDOR=nvidia scripts/start_vllm.sh --dry-run
# ============================================================================

# ---------------------------------------------------------------------------
# 0. 运行方式（RUNTIME）：docker = 容器内跑（默认）；host = 物理机/裸机直接跑
#    两种方式跑的是完全相同的探针/套件/报告，产物结构也相同；
#    host 模式不需要镜像/容器，直接在本机 Python 环境里起 vLLM。
#    详细指南见 docs/物理机模式.md。
# ---------------------------------------------------------------------------
# docker | host。写 host 后 make up/down/status/probe 等目标自动走物理机；
# 也可临时切换：make up RUNTIME=host 或 make up-host（scripts/start_vllm.sh --host）。
RUNTIME=docker

# --- host（物理机）模式专用（RUNTIME=docker 时全部被忽略） ---
# 本机 Python 解释器（要求能 `import vllm`；建议用装好 vLLM 的 venv/conda 解释器）
HOST_PYTHON=python3
# 自定义启动命令（留空 = 自动用 HOST_PYTHON 执行 vLLM CLI 入口
# `from vllm.entrypoints.cli.main import main`；一般不用改；
# 调试/特殊入口时可写成 `bash -lc '... exec vllm serve ...'` 之类）
HOST_SERVE_ENTRYPOINT=
# 启动前自动做环境预检（1=开，0=关）；预检项见 `make host-check`
HOST_PRECHECK=1
# 启动前要准备的环境（空格分隔的 token，按书写顺序执行，顺序有意义）：
#   K=V      → export 该环境变量（给后面的环境脚本准备变量，如 DTK_ROOT）
#   其它路径 → 存在则 source（厂商环境如 DTK/Ascend 的 set_env.sh；不存在静默跳过）
# 例：DTK 的 env.sh 依赖先 export DTK_ROOT 再 source：
# HOST_PRELUDE_FILES="DTK_ROOT=/mnt/game/host-runtime/dtk2604 /home/lyh/z100-vllm/tools/dcu/env.sh"
HOST_PRELUDE_FILES=
# 停止实例时等待优雅退出的秒数（超时后按 HOST_VLLM_PATTERN 强杀进程组）
HOST_STOP_TIMEOUT=60
# 停止后默认会轮询本机 SMI 等显存回落（最长约 60s）。同机还有其它显存占用、
# 或只是假实例调试时建议跳过：设 1（等价 stop_vllm.sh --no-vram-wait）
# PROBE_SKIP_VRAM_WAIT=1
# host 模式按进程名兜底清理/查找 vLLM 进程的正则（含 | 必须整体加引号）
# 引擎默认值另见 engines/<id>.sh 的 ENGINE_PROCESS_PATTERN（host 模式进程正则
# 优先级链：显式 HOST_ENGINE_PATTERN > 引擎 profile > 本键）。
HOST_VLLM_PATTERN="vllm.entrypoints.cli.main|vllm\.v1\.engine|EngineCore|APIServer"
# py-spy 可执行文件（host 模式直接用本机 py-spy；留空=用 PATH 里的 py-spy）
PYSPY_BIN=

# ---------------------------------------------------------------------------
# 0b. 引擎组件（ENGINE）：被探测/启动的推理引擎是谁（与厂商 VENDOR 正交）
#    引擎组件 = 提供服务进程的软件（替换 serve 入口）；DeepEP 这类只追加
#    flag/env 的增强型组件不走本接口，继续用 hosts/<类目>/*.env 模板。
#    shell 端注册表 engines/<id>.sh ↔ Python 端 probe/engines.py（键集合由
#    tests/test_engines.py 强制一致）；接入新引擎见 docs/design/README.md §4。
# ---------------------------------------------------------------------------
# 引擎组件 id：vllm（默认）| strata | …；未知 id 启动时直接报错并列出可用值。
# 不设置（或 vllm）时行为与历史版本完全一致。
# ENGINE=vllm
# 采集引擎专有指标（如 strata:*）：probe metrics --engine-extras 或此键=1 开启；
# 默认关闭（快照产物不出现 engine_extra 段，schema 不变）。
PROBE_ENGINE_EXTRAS=0
# 引擎无关的追加参数（末尾追加，语义同 EXTRA_VLLM_ARGS；对 vLLM 两者等效合并）。
# 模板追加型键：显式导出同名变量会丢弃模板追加（show/dry-run 会打 ⚠️）。
EXTRA_ENGINE_ARGS=
# 显式覆盖进程查找正则（stop/status/pyspy 共用）。优先级链：
#   显式环境/模板 > engines/<id>.sh 的 ENGINE_PROCESS_PATTERN > HOST_VLLM_PATTERN（旧键，保留兼容）
HOST_ENGINE_PATTERN=

# ---------------------------------------------------------------------------
# 1. 厂商与镜像（核心：决定容器设备直通/环境注入/遥测命令）
#    ⚠️ 本节 IMAGE / CONTAINER / MODE / EXEC_CONTAINER 以及 §3 的
#    EXTRA_MOUNTS、GAME_DIR、SRC_DIR 挂载语义只在 RUNTIME=docker 下生效；
#    host 模式下厂商的设备可见性环境变量与 HOST_PRELUDE_FILES 仍然生效，
#    但 docker 设备直通参数（--device/--gpus/--group-add）会被忽略。
# ---------------------------------------------------------------------------
# auto = 自动探测（ascend → nvidia → hygon → amd → intel，都不命中回退 generic）
# 也可显式指定：generic | nvidia | amd | hygon | intel | ascend | 自行适配的厂商
# 详见 vendors/README.md 与 `python3 -m probe vendor`
VENDOR=auto

# 基础镜像。留空 → 用厂商 profile 的默认镜像（如 nvidia: vllm/vllm-openai:latest）；
# 本站点（hygon）必须显式指定：
IMAGE=z100-s9-snap-s14

# 探测实例的容器名（刻意与现网 z100-vllm 区分开）
CONTAINER=vllm-probe
# run = 新建容器（推荐）；exec = 复用已有容器
MODE=run
# MODE=exec 时复用的容器名，以及容器内日志目录（需是宿主机挂载进去的目录）
EXEC_CONTAINER=z100-vllm
EXEC_LOG_DIR=/mnt/game/vllm-probe

# vLLM 源码 checkout（挂到容器 /src；留空则不挂载、不设置 /src 的 PYTHONPATH）
SRC_DIR=/home/lyh/z100-vllm

# --- 各家镜像是怎么选的（示例，改 VENDOR 时同步改 IMAGE）---
# nvidia : IMAGE=vllm/vllm-openai:latest      （需 nvidia-container-toolkit）
# amd    : IMAGE=rocm/vllm:latest
# intel  : IMAGE=intel/vllm:latest
# ascend : IMAGE=quay.io/ascend/vllm-ascend:latest
# generic: 任意带 vLLM 的镜像（无设备直通，用于 mock/CI）

# ---------------------------------------------------------------------------
# 2. 端口与鉴权（重要：默认 8100，避免打到现网正在做 A/B 的 8000）
# ---------------------------------------------------------------------------
PORT=8100
# 容器内监听端口（MODE=run 时默认等于 PORT；用 docker-compose 时填 8000）
# INTERNAL_PORT=8000
# 实例带 --api-key 启动时，探测请求需要带同一个 key（可选）。
# 设置后：请求级探测、probe env 的基础端点检查、status.sh 的 /v1/models 与 /metrics
#   检查都会带 Authorization: Bearer <VLLM_API_KEY>；探测产物（http_summary.json 等）
#   里的 api_key 会打码（如 sk-z***310f），不会明文落盘。启动类产物（cmd.txt/args.txt/
#   run_meta.json 的 command、serve_launch.sh）按启动命令原样记录，含 --api-key 时请
#   自行保护运行目录权限。留空 = 不发 Authorization（兼容未设 --api-key 的实例）。
VLLM_API_KEY=

# ---------------------------------------------------------------------------
# 3. 模型与并行
# ---------------------------------------------------------------------------
MODEL=/mnt/game/models/Qwen3.8-27B-FP8
SERVED_NAME=qwen3.8-27b
TP=4
DTYPE=float16
GPU_MEM_UTIL=0.85
MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=64
# 1 = --enforce-eager（现网生产臂是 eager）
EAGER=1
# 可见卡。实际注入的环境变量名由厂商决定：
#   nvidia→CUDA_VISIBLE_DEVICES / amd,hygon→HIP_VISIBLE_DEVICES /
#   ascend→ASCEND_RT_VISIBLE_DEVICES / intel→ZE_AFFINITY_MASK
VISIBLE_DEVICES=0,1,2,3

# --- 投机解码（留空 DRAFT_MODEL 表示不启用；启用时必须给 SPEC_METHOD）---
DRAFT_MODEL=/mnt/game/models/Qwen3.8-27B-DFlash2-ms
SPEC_METHOD=dflash
SPEC_TOKENS=7
# 草稿模型 dtype（bf16 草稿在 fp16 下会溢出，现网就是这么设的）
SPEC_DTYPE=bfloat16
SPEC_KV_DTYPE=bfloat16

# --- 其它模型相关参数（会被追加到 vLLM 命令行；值含空格时必须加引号；
#     不能带引号的 JSON 请用 EXTRA_ARGS_FILE）---
EXTRA_VLLM_ARGS="--disable-custom-all-reduce --skip-mm-profiling --enable-prefix-caching --mamba-cache-mode align"
# 需要带空格/JSON 的参数时，写到一个文件里，每行一个参数：
# EXTRA_ARGS_FILE=/home/lyh/vllm-test/llm-engine-probe/configs/extra-args.txt

# 额外环境变量（空格分隔的 K=V 列表，注入容器；与厂商无关的通用透传）：
EXTRA_ENV="VLLM_DCU_USE_BF16_GEMV=1 VLLM_DCU_USE_FP8_EMU=1 VLLM_DCU_FP8_GEMV_MAX_M=4"

# 额外挂载（空格分隔的 host:container[:ro] 列表，如模型盘/数据盘）：
# EXTRA_MOUNTS=/data/models:/data/models:ro
# 共享数据目录（可选；设置后按原路径挂进容器，如本站点的 /mnt/game）
GAME_DIR=/mnt/game

# ---------------------------------------------------------------------------
# 4. 观测档位（本项目的核心开关）
#    off    : 不加任何观测开关，作为对照基线
#    basic  : 只有默认的周期 stats 日志 + /metrics
#    steps  : 逐 iteration 明细 + 逐请求日志 + 响应体里的 metrics 字段   ← 推荐
#    deep   : steps + KV block 驻留 + 图调度统计 + MFU + 逐步投机解码指标
#    kernel : deep + torch profiler（配 /start_profile）+ 逐层 NVTX（会关图模式）
# ---------------------------------------------------------------------------
PROBE_LEVEL=steps

# 周期 stats 打印间隔（秒）
LOG_STATS_INTERVAL=5
# 批次大小日志间隔
LOG_BATCHSIZE_INTERVAL=100
VLLM_LOGGING_LEVEL=INFO

# deep 档：KV block 采样率
KV_CACHE_METRICS_SAMPLE=0.05
# deep 档：逐请求投机解码指标级别（none|summary|detailed）
PER_REQUEST_SPEC_METRICS=detailed
# kernel 档：torch profiler 选项
PROFILER_WITH_STACK=true
PROFILER_WITH_FLOPS=true
PROFILER_RECORD_SHAPES=true
PROFILER_WITH_MEMORY=true
# kernel 档：逐层 NVTX（与 CUDA/HIP Graph 冲突，脚本会自动加 --enforce-eager）
ENABLE_LAYERWISE_NVTX=1
# kernel 档：把引擎内部子步骤（schedule: * / gpu_model_runner: * / llm_engine step: *）
# 打成 torch profiler 的 record_function 范围，报告会出现 "Top CPU 侧范围" 表
ENABLE_PROFILING_SCOPES=1
# 想改用 NVTX 范围（给 rocprof/nsys 用）而非 torch record_function 时设为 1（CUSTOM 优先）
ENABLE_NVTX_SCOPES=0

# ---------------------------------------------------------------------------
# 4b. stat logger 插件（与档位正交；最深一层的数据：逐 step / 逐请求结构化统计）
#   1 = 启动时自动安装插件并把 JSONL 写到 <RUN_DIR>/probe_steps.jsonl
#   注意：不要设置 VLLM_PLUGINS（那是全局白名单，会禁用 vLLM 自带的 general_plugins）
# ---------------------------------------------------------------------------
PROBE_PLUGIN=0
PROBE_LOG_NAME=probe_steps.jsonl

# ---------------------------------------------------------------------------
# 5. 请求级探测默认负载
# ---------------------------------------------------------------------------
PROMPT_TOKENS=512
MAX_TOKENS=128
CONCURRENCY=1
REPEAT=3
# >0 时会在每个请求前拼一段相同前缀，用来探测前缀缓存命中
SHARED_PREFIX_TOKENS=0
PROBE_ENDPOINT=chat

# ---------------------------------------------------------------------------
# 6. 目录与缓存 / 外部日志（站点相关，按你的机器修改；留空表示不注入对应环境变量）
# ---------------------------------------------------------------------------
RUNS_DIR=/home/lyh/vllm-test/llm-engine-probe/runs
# 外部启动实例的日志路径（可选；也可用 probe_all.sh --log-file PATH 临时指定，两者等价）。
# 实例不是本工具启动、日志不在 <RUN_DIR>/serve.log 时设置：probe_all.sh 会把它复制为
# <RUN_DIR>/serve.log 再做 step 级解析，同时把路径写进 run_meta.json 的 serve_log；
# report 在 <RUN_DIR>/serve.log 不存在时回退读该外部日志。
PROBE_LOG_FILE=
VLLM_CACHE_ROOT=/mnt/game/vllm-cache-probe
TRITON_CACHE_DIR=/mnt/game/triton-gfx906/cache
TRITON_INSTALL_DIR=/mnt/game/triton-gfx906/install

# 仅 hygon 档位使用的容器内环境脚本（不 source 会导致
# `import torch` 报 librocm_smi64.so.2: cannot open shared object file）；置空可跳过
DTK_ENV_FILE=/opt/dtk/env.sh
DCU_ENV_FILE=/src/tools/dcu/env.sh
# 现网 hygon 需要它来走 RCCL P2P
HSA_FORCE_FINE_GRAIN_PCIE=1
# 容器内最终的 PYTHONPATH（一般留空自动拼装：[/src:]opt/vllm-probe[:triton]）
# PYTHONPATH_IN_CONTAINER=/src:/opt/vllm-probe:/mnt/game/triton-gfx906/install
# 冷启动等待上限（27B/TP4 大约 5~15 分钟）
WARMUP_TIMEOUT=900

# ---------------------------------------------------------------------------
# 7. GPU 遥测采样（gpu_sample.sh，backend 由厂商决定：
#    hygon=hy-smi / nvidia=nvidia-smi / amd=amd-smi|rocm-smi / ascend=npu-smi / intel=xpu-smi）
# ---------------------------------------------------------------------------
GPU_SAMPLE_INTERVAL=1

# ---------------------------------------------------------------------------
# 8. 观测栈（docker-compose.obs.yml 用，可选；仅 RUNTIME=docker）
#    host 模式不启动这套 compose，用外部 Prometheus 直接抓宿主机 :PORT/metrics
# ---------------------------------------------------------------------------
PROM_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASS=admin
SHM_SIZE=16g
